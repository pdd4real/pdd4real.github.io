// Light blue palette. Layout and typography remain unchanged.
:root
  --body-bg-color: #F1F8FD
  --content-bg-color: #FFFFFF
  --card-bg-color: #DCECF8
  --text-color: #3E596E
  --selection-bg: #A8CBE5
  --selection-color: #1F405C
  --blockquote-color: #58758C
  --link-color: #2F6F9F
  --link-hover-color: #225477
  --brand-color: #1F405C
  --brand-hover-color: #225477
  --table-row-odd-bg-color: #EDF6FC
  --table-row-hover-bg-color: #DCECF8
  --menu-item-bg-color: #DCECF8
  --theme-color: #3E7CB1
  --btn-default-bg: #3E7CB1
  --btn-default-color: #FFFFFF
  --btn-default-border-color: #3E7CB1
  --btn-default-hover-bg: #2F6F9F
  --btn-default-hover-color: #FFFFFF
  --btn-default-hover-border-color: #2F6F9F

@media (prefers-color-scheme: dark)
  :root
    --theme-color: #244E70
    --link-color: #A7D0ED
    --link-hover-color: #D0E8F8
