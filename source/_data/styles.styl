// Deep blue palette. Layout and typography remain unchanged.
:root
  --body-bg-color: #0B2035
  --content-bg-color: #143A59
  --card-bg-color: #173F60
  --text-color: #EAF4FC
  --selection-bg: #2F79A8
  --selection-color: #FFFFFF
  --blockquote-color: #BBD6E8
  --link-color: #8FD3FF
  --link-hover-color: #C7EAFF
  --brand-color: #F3FAFF
  --brand-hover-color: #FFFFFF
  --table-row-odd-bg-color: #173F60
  --table-row-hover-bg-color: #1C4A6D
  --menu-item-bg-color: #173F60
  --theme-color: #1F6F9F
  --btn-default-bg: #1F6F9F
  --btn-default-color: #FFFFFF
  --btn-default-border-color: #1F6F9F
  --btn-default-hover-bg: #2F86BA
  --btn-default-hover-color: #FFFFFF
  --btn-default-hover-border-color: #2F86BA

@media (prefers-color-scheme: dark)
  :root
    --theme-color: #1F6F9F
    --link-color: #8FD3FF
    --link-hover-color: #C7EAFF

body
  background: #0B2035
  color: #EAF4FC

a
  color: #8FD3FF

a:hover
  color: #C7EAFF

.header
  background: #102E49

.site-meta
  background: #102E49

.site-title,
.site-subtitle,
.menu-item a,
.menu-item-active a
  color: #F3FAFF

.main-inner .post-block,
.main-inner .tabs-comment,
.main-inner > .comments,
.main-inner .comment-position .comments,
.main-inner .pagination
  background: #143A59
  color: #EAF4FC

.sidebar
  background: #102E49
  color: #EAF4FC

.sidebar a,
.sidebar-nav li a,
.site-state-item a
  color: #BBDFF4

.sidebar a:hover,
.sidebar-nav li a:hover,
.site-state-item a:hover
  color: #FFFFFF

.post-title,
.post-title-link,
.post-body h1,
.post-body h2,
.post-body h3,
.post-body h4,
.post-body h5,
.post-body h6
  color: #F3FAFF

.post-meta,
.post-meta a,
.post-description
  color: #BBD6E8

.post-body
  color: #EAF4FC

.post-body strong
  color: #FFFFFF

.post-body blockquote
  background: #173F60
  border-left-color: #4E9DCC
  color: #C8E0EF

.post-body table
  background: #143A59
  color: #EAF4FC

.post-body th
  background: #1C4A6D
  color: #FFFFFF

.post-body td,
.post-body th
  border-color: #356682

.post-body code
  background: #1C4A6D
  color: #D9F0FF

.post-button .btn,
.pagination .page-number.current
  background: #1F6F9F
  border-color: #1F6F9F
  color: #FFFFFF

.post-button .btn:hover,
.pagination a:hover
  background: #2F86BA
  border-color: #2F86BA
  color: #FFFFFF

.footer,
.footer a
  color: #A9C9DD
