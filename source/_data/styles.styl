// Light blue palette. Layout and typography remain unchanged.
:root
  --body-bg-color: #F7FBFF
  --content-bg-color: #FFFFFF
  --card-bg-color: #EAF4FC
  --text-color: #526B7D
  --selection-bg: #BBDCF4
  --selection-color: #24445D
  --blockquote-color: #6B879D
  --link-color: #4B91C5
  --link-hover-color: #2F6F9D
  --brand-color: #24445D
  --brand-hover-color: #2F6F9D
  --table-row-odd-bg-color: #F4FAFF
  --table-row-hover-bg-color: #EAF4FC
  --menu-item-bg-color: #EAF4FC
  --theme-color: #6FA9D8
  --btn-default-bg: #6FA9D8
  --btn-default-color: #FFFFFF
  --btn-default-border-color: #6FA9D8
  --btn-default-hover-bg: #4B91C5
  --btn-default-hover-color: #FFFFFF
  --btn-default-hover-border-color: #4B91C5

@media (prefers-color-scheme: dark)
  :root
    --theme-color: #355D7A
    --link-color: #9CC9EA
    --link-hover-color: #C5E4F7
